---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../data/site';
import { projects, math } from '../data/projects';
import { essays } from '../data/writing';
import { art, photos } from '../data/art';
import { shelves } from '../data/company';

const [first, ...rest] = site.name.split(' ');
const last = rest.join(' ');
const strip = [...art, ...photos].filter((p) => p.image);
---

<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="label hero-kicker">
        <span>Index</span><span>{site.places.join(' / ')}</span><span data-today></span>
      </p>
      <h1 class="hero-name" aria-label={site.name}>
        <span class="line" aria-hidden="true">
          {first.split('').map((c, i) => <span class="ch" style={`--i:${i}`}>{c}</span>)}
        </span>
        <span class="line line-2" aria-hidden="true">
          <em>
            {last.split('').map((c, i) => (
              <span class="ch" style={`--i:${i + first.length + 1}`}>{c}</span>
            ))}
          </em>
          <span class="ch dot" style={`--i:${site.name.length + 1}`}>.</span>
        </span>
      </h1>
      <p class="hero-makes">
        <em class="cycle" data-cycle={site.lines.join('|')}>{site.lines[0]}</em>
      </p>
      <p class="hero-intro">{site.intro}</p>
      <a class="label hero-scroll" href="#about">scroll <span aria-hidden="true">↓</span></a>
    </div>

    <div class="comp" data-parallax aria-hidden="true">
      <div class="comp-main" style="--depth:8">
        <canvas class="sky" data-sky="day"></canvas>
      </div>
      <div class="comp-minor" style="--depth:20">
        <canvas class="sky" data-sky="dusk"></canvas>
      </div>
      <span class="comp-line l1" style="--depth:14"></span>
      <span class="comp-line l2" style="--depth:26"></span>
      <span class="spaced w1" style="--depth:30">here</span>
      <span class="spaced w2" style="--depth:22">right</span>
      <span class="spaced w3" style="--depth:34">now.</span>
    </div>
  </section>

  <section class="about wrap" id="about">
    <div class="about-side">
      <p class="label" data-reveal>00 — about</p>
      <div class="portrait" data-reveal style="--d:100ms">
        <Placeholder
          src={site.portrait || undefined}
          alt={`Portrait of ${site.name}`}
          tone="blush"
          ratio="3 / 4"
          label="portrait"
          note="a photo of you"
        />
      </div>
      <dl class="facts" data-reveal style="--d:200ms">
        {site.facts.map((f) => (
          <div>
            <dt class="label">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="about-body">
      <p class="about-lead" data-reveal>{site.thesis}</p>
      <div class="about-rest">
        {site.about.map((p, i) => (
          <p data-reveal style={`--d:${(i + 1) * 120}ms`}>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap" id="research">
    <SectionHead
      no="01"
      kicker="inquiry"
      title="Research"
      ipa="/rɪˈsɜːtʃ/"
      aside="noun · steering the dynamics of systems"
    />
    <ol class="years">
      {site.research.map((r, i) => (
        <li class="year" data-reveal style={`--d:${i * 120}ms`}>
          <span class="year-no">{r.year}</span>
          <p class="year-text">{r.text}</p>
          <span class="label year-tag">{r.tag ?? ''}</span>
        </li>
      ))}
    </ol>
    <p class="label values" data-reveal>
      {site.values.map((v) => <span>{v}</span>)}
    </p>
  </section>

  <section class="section wrap" id="projects">
    <SectionHead no="02" kicker="work" title="Projects" />
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <section class="section wrap" id="math">
    <SectionHead no="03" kicker="play" title="Mathematical Curiosities" aside="for the fun of it" />
    <div class="grid grid-quiet">
      {math.map((p, i) => <ProjectCard project={p} index={i} prefix="m" />)}
    </div>
  </section>

  <section class="section wrap" id="writing">
    <SectionHead no="04" kicker="words" title="Writing" aside="essays, with pictures beside them" />
    {
      essays.map((e) => (
        <article class="essay">
          <div class="essay-art" data-reveal>
            {e.glyph && <span class="essay-glyph" aria-hidden="true">{e.glyph}</span>}
            <Placeholder
              src={e.art}
              alt={`Art for ${e.title}`}
              tone={e.tone}
              ratio="3 / 4"
              label={`art — ${e.title}`}
              note="picture to come"
            />
          </div>
          <div class="essay-text">
            <p class="label" data-reveal>essay · {e.date}</p>
            <h3 class="essay-title" data-reveal style="--d:80ms">
              <a href={e.href} target="_blank" rel="noopener">{e.title}</a>
            </h3>
            <p class="essay-sub" data-reveal style="--d:160ms">{e.subtitle}</p>
            {e.quote && (
              <blockquote class="essay-quote" data-reveal style="--d:240ms">
                “{e.quote}”
              </blockquote>
            )}
            <a class="label link-out" href={e.href} target="_blank" rel="noopener" data-reveal style="--d:320ms">
              Read on Substack <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))
    }
    <div class="reading" id="reading">
      <div class="shelves">
        {shelves.map((g, i) => (
          <div class="shelf" data-reveal style={`--d:${(i % 3) * 100}ms`}>
            <h3 class="label">{g.label}</h3>
            <ul>
              {g.items.map((b) => (
                <li>
                  {b.href ? (
                    <a href={b.href} target="_blank" rel="noopener">
                      <em>{b.title}</em> <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <em>{b.title}</em>
                  )}
                  {b.by && <span class="label">{b.by}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap" id="salons">
    <SectionHead no="05" kicker="people" title="Salons" />
    <p class="coming-soon"><em>Coming soon.</em></p>
  </section>

  <section class="section" id="art">
    <div class="wrap">
      <SectionHead
        no="06"
        kicker="pictures"
        title="Art"
        quote={site.artQuote.text}
        by={site.artQuote.by}
      />
    </div>
    <a class="strip" href="/art" aria-label="See all art">
      <div class="strip-track">
        {
          [...strip, ...strip].map((a, i) => (
            <div class="strip-item" aria-hidden={i >= strip.length ? 'true' : undefined}>
              <Placeholder src={a.image} alt={a.title} tone={a.tone} ratio={a.ratio} note="" eager />
            </div>
          ))
        }
      </div>
    </a>
    <div class="wrap strip-foot">
      <a class="label link-out" href="/art">See all art <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
