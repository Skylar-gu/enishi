---
import Placeholder from './Placeholder.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  prefix?: string;
}
const { project, index, prefix = '' } = Astro.props;
const no = `${prefix}${String(index + 1).padStart(3, '0')}`;
const Tag = project.href ? 'a' : 'div';
const linkProps = project.href ? { href: project.href, target: '_blank', rel: 'noopener' } : {};
---

<article class="card" data-reveal style={`--d:${(index % 2) * 120}ms`}>
  <Tag class="card-link" {...linkProps}>
    <div class="card-media">
      <Placeholder
        src={project.image}
        alt={project.title}
        tone={project.tone}
        ratio="4 / 3"
        label={no}
        note={project.want ?? 'image to come'}
      />
    </div>
    <div class="card-body">
      <h3 class="card-title">
        {project.title}
        {project.href && <span class="arrow" aria-hidden="true">↗</span>}
      </h3>
      <p class="label card-meta">{project.meta}</p>
      {project.blurb && <p class="card-blurb">{project.blurb}</p>}
      {project.credit && <p class="label card-credit">Image: {project.credit}</p>}
    </div>
  </Tag>
</article>
