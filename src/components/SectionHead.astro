---
interface Props {
  no: string;
  kicker: string;
  title: string;
  aside?: string;
}
const { no, kicker, title, aside } = Astro.props;
---

<header class="shead">
  <p class="label shead-kicker" data-reveal>{no} — {kicker}</p>
  <h2 class="shead-title" data-reveal style="--d:80ms">{title}</h2>
  {aside && <p class="label shead-aside" data-reveal style="--d:160ms">— {aside}</p>}
</header>
