---
import { site } from '../data/site';
const { substack, github, email } = site.links;
---

<footer class="footer wrap" id="hello">
  <p class="label" data-reveal>— correspondence</p>
  <h2 class="footer-title" data-reveal style="--d:80ms">Say <em>hello</em><span class="dot">.</span></h2>
  <ul class="footer-links" data-reveal style="--d:160ms">
    {email && <li><a href={`mailto:${email}`}>Email <span aria-hidden="true">↗</span></a></li>}
    <li><a href={substack} target="_blank" rel="noopener">Substack <span aria-hidden="true">↗</span></a></li>
    <li><a href={github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a></li>
  </ul>
  <div class="footer-base label">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span class="spaced">here, for now.</span>
    <span data-today></span>
  </div>
</footer>
